    },
    {
      "id": "box_style_body",
      "type": "text",
      "x": 92,
      "y": 388,
      "width": 236,
      "height": 175,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 324943,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "text": "Option A: Style Bank (s_emo)\n  [warm, excited, whisper, ...]\nOption B: Style Encoder (Mel Spec)\n  Conv1D ResBlks + AvgPool\nDisentangled Style Vector:\n  s = [s_timbre (Jeet) || s_prosody]\nShape: s \u2208 \u211d^(B \u00d7 64)\nL2-Normalized",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "Option A: Style Bank (s_emo)\n  [warm, excited, whisper, ...]\nOption B: Style Encoder (Mel Spec)\n  Conv1D ResBlks + AvgPool\nDisentangled Style Vector:\n  s = [s_timbre (Jeet) || s_prosody]\nShape: s \u2208 \u211d^(B \u00d7 64)\nL2-Normalized"
    },
