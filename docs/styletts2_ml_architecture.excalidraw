      "seed": 150877,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "text": "\u2022 Conditioned on: H_text & Style s\n\u2022 Duration Predictor (Bi-GRU)\n\u2022 Predicts phoneme duration d_i\n\u2022 Alignment Expansion / MAS:\n  T_text \u2500\u2500\u2794 T_frames (frame-level)\nOutput: H_frame\nShape: (B, T_frames, 512)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 Conditioned on: H_text & Style s\n\u2022 Duration Predictor (Bi-GRU)\n\u2022 Predicts phoneme duration d_i\n\u2022 Alignment Expansion / MAS:\n  T_text \u2500\u2500\u2794 T_frames (frame-level)\nOutput: H_frame\nShape: (B, T_frames, 512)"
    },
